<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* ============================================================</c>
<c>* Halcon_UI 示例：HTTP Stream 推送图像到浏览器</c>
<c>*</c>
<c>* 使用方法：</c>
<c>*   1. 运行本脚本（会停在 stop 处）</c>
<c>*   2. 浏览器打开 http://127.0.0.1:9090</c>
<c>*   3. 点击 Start Stream</c>
<c>*   4. 回到 HDevelop 按 F5 开始推送图像</c>
<c>* ============================================================</c>
<c></c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>dev_open_window (0, 0, 640, 480, 'black', WindowHandle)</l>
<l>set_display_font (WindowHandle, 16, 'mono', 'true', 'false')</l>
<c></c>
<c>* --- 1. 启动 HTTP 服务器 ---</c>
<l>WCreateWebServer (9090, ServerID)</l>
<l>disp_message (WindowHandle, 'HTTP 服务器已启动 (端口 9090)', 'window', 12, 12, 'lime green', 'false')</l>
<l>disp_message (WindowHandle, '浏览器打开 http://127.0.0.1:9090', 'window', 42, 12, 'white', 'false')</l>
<l>disp_message (WindowHandle, '点 Start Stream 后按 F5 继续', 'window', 72, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c></c>
<c>* --- 2. 循环推送图像 ---</c>
<c as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,1]" as_ord="1">* Image Acquisition 01: Code generated by Image Acquisition 01</c>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,2]" as_ord="1">list_files ('F:/MYXH/明场样本图/ChippingA1', ['files','follow_links','recursive'], ImageFiles)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,3]" as_ord="1">tuple_regexp_select (ImageFiles, ['\\.(tif|tiff|gif|bmp|jpg|jpeg|jp2|png|pcx|pgm|ppm|pbm|xwd|ima|hobj)$','ignore_case'], ImageFiles)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,2]" as_ord="1">for NumImages := 0 to |ImageFiles| - 1 by 1</l>
<c></c>
<c></c>
<l>    read_image (Image, ImageFiles[NumImages])</l>
<l>    get_image_size (Image, Width, Height)</l>
<l>    count_channels (Image, Channels)</l>
<c></c>
<c>    * 构造发送字典（CMD=0 表示图像）</c>
<l>    create_dict (SendDict)</l>
<l>    create_dict (CmdDict)</l>
<l>    create_dict (DataDict)</l>
<l>    set_dict_tuple (CmdDict, 'CMD', 0)</l>
<l>    set_dict_tuple (DataDict, '宽', Width)</l>
<l>    set_dict_tuple (DataDict, '高', Height)</l>
<l>    set_dict_tuple (DataDict, '位深', 1)</l>
<l>    set_dict_tuple (DataDict, '通道', Channels)</l>
<l>    set_dict_tuple (CmdDict, 'Data', DataDict)</l>
<l>    set_dict_tuple (SendDict, '命令', CmdDict)</l>
<l>    set_dict_object (Image, SendDict, '图')</l>
<c></c>
<l>    WSendWebData (ServerID, SendDict)</l>
<c></c>
<l>    dev_display (Image)</l>
<l>*     disp_message (WindowHandle, '推送: ' + (I + 1) + '/' + NumImages + '  [' + Width + 'x' + Height + ' Ch:' + Channels + ']', 'window', 12, 12, 'lime green', 'true')</l>
<l>*     wait_seconds (0.1)</l>
<l>endfor</l>
<c></c>
<c>* --- 3. 发送完成命令 ---</c>
<l>create_dict (SendDict2)</l>
<l>create_dict (CmdDict2)</l>
<l>set_dict_tuple (CmdDict2, 'CMD', 1)</l>
<l>create_dict (MsgData)</l>
<l>set_dict_tuple (MsgData, 'message', '所有图像发送完毕')</l>
<l>set_dict_tuple (MsgData, 'total', NumImages)</l>
<l>set_dict_tuple (CmdDict2, 'Data', MsgData)</l>
<l>set_dict_tuple (SendDict2, '命令', CmdDict2)</l>
<l>WSendWebData (ServerID, SendDict2)</l>
<c></c>
<l>disp_message (WindowHandle, '推送完成，按 F5 关闭服务器', 'window', 42, 12, 'yellow', 'true')</l>
<l>stop ()</l>
<c></c>
<l>WCloseWebServer (ServerID)</l>
<l>disp_message (WindowHandle, '服务器已关闭', 'window', 72, 12, 'red', 'true')</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
