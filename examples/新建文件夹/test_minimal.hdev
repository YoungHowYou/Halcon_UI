<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 最小测试：启动服务器 → 浏览器连接 → 发命令 → 关闭</c>
<c>* 浏览器打开 http://127.0.0.1:9090 点 Start Stream</c>
<c></c>
<l>WCreateWebServer (9090, ServerID)</l>
<l>stop ()</l>
<c>* 发一条 JSON 命令到前端</c>
<l>create_dict (SendDict)</l>
<l>WRecvWebData (ServerID, 1000, SendDict)</l>
<c></c>
<l>create_dict (CmdDict)</l>
<l>set_dict_tuple (CmdDict, 'CMD', 1)</l>
<l>create_dict (DataDict)</l>
<l>set_dict_tuple (DataDict, 'msg', 'hello from halcon')</l>
<l>set_dict_tuple (CmdDict, 'Data', DataDict)</l>
<l>set_dict_tuple (SendDict, '命令', CmdDict)</l>
<l>WSendWebData (ServerID, SendDict)</l>
<l>stop ()</l>
<c></c>
<l>WCloseWebServer (ServerID)</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
