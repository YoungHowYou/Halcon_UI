<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* ============================================================</c>
<c>* Halcon_UI 例程：WebSocket 双向通信 + 状态推送 + 命令分发</c>
<c>*</c>
<c>* 功能：</c>
<c>*   1. 启动 WebSocket 服务器（端口 3000）</c>
<c>*   2. 主循环每轮：</c>
<c>*      a. 非阻塞收一条前端命令并按 CMD 分发</c>
<c>*      b. 推一张图（CMD=0，后端自动 JPEG 压缩）</c>
<c>*      c. 每秒推送设备状态(CMD=3) / 系统资源(CMD=4)</c>
<c>*   3. 收到 CMD=999 退出</c>
<c>*</c>
<c>* 使用方法：</c>
<c>*   1. 运行本脚本（会停在第一个 stop 处）</c>
<c>*   2. 浏览器打开 http://127.0.0.1:3000  (前端会自动 WS 升级到 /ws)</c>
<c>*   3. 回到 HDevelop 按 F5 进入主循环</c>
<c>*   4. 在前端 console 执行 sendCmd(999, {}) 触发退出</c>
<c>* ============================================================</c>
<c></c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>dev_open_window (0, 0, 800, 600, 'black', WindowHandle)</l>
<l>set_display_font (WindowHandle, 14, 'mono', 'true', 'false')</l>
<c></c>
<c>* ---------- 1. 启动 WebSocket 服务器 ----------</c>
<l>Port := 3000</l>
<l>WCreateWebServer (Port, ServerID)</l>
<l>disp_message (WindowHandle, 'WebSocket 服务器已启动 (端口 ' + Port + ')', 'window', 12, 12, 'lime green', 'false')</l>
<l>disp_message (WindowHandle, '浏览器打开 http://127.0.0.1:' + Port, 'window', 36, 12, 'white', 'false')</l>
<l>disp_message (WindowHandle, '页面加载后会自动升级到 ws://.../ws', 'window', 60, 12, 'white', 'false')</l>
<l>disp_message (WindowHandle, '按 F5 进入主循环（推图 + 命令分发）', 'window', 96, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c></c>
<c>* ---------- 2. 准备测试图像（HALCON 自带） ----------</c>
<l>ImgNames := ['fabrik', 'mreut', 'monkey', 'patras', 'particle']</l>
<l>NumImgs := |ImgNames|</l>
<l>ImgIdx := 0</l>
<c></c>
<c>* ---------- 3. 主循环 ----------</c>
<l>Running := true</l>
<l>FrameSeq := 0</l>
<l>count_seconds (TStart)</l>
<l>LastStatusPush := TStart</l>
<l>LastStatsPush := TStart</l>
<c></c>
<l>while (Running)</l>
<l>    count_seconds (TNow)</l>
<c></c>
<c>    * ---- (a) 非阻塞收命令（timeout=0），单轮可能没有 ----</c>
<l>    create_dict (RecvDict)</l>
<l>    try</l>
<l>        WRecvWebData (ServerID, 0, RecvDict)</l>
<l>        get_dict_tuple (RecvDict, '命令', CmdJson)</l>
<l>        get_dict_tuple (CmdJson, 'CMD', CMD)</l>
<l>        try</l>
<l>            get_dict_tuple (CmdJson, 'Data', CmdData)</l>
<l>        catch (Ex2)</l>
<l>            create_dict (CmdData)</l>
<l>        endtry</l>
<l>        disp_message (WindowHandle, '<- CMD=' + CMD, 'window', 12, 12, 'cyan', 'true')</l>
<c></c>
<l>        if (CMD == 200)</l>
<c>            * 设备连接状态查询 -> 回复 CMD=200</c>
<l>            create_dict (R)</l>
<l>            create_dict (RC)</l>
<l>            create_dict (RD)</l>
<l>            set_dict_tuple (RC, 'CMD', 200)</l>
<l>            set_dict_tuple (RD, 'cam', 1)</l>
<l>            set_dict_tuple (RD, 'plc', 1)</l>
<l>            set_dict_tuple (RD, 'db', 1)</l>
<l>            set_dict_tuple (RD, 'feishu', 'ok')</l>
<l>            set_dict_tuple (RD, 'scanner', 1)</l>
<l>            set_dict_tuple (RD, 'scannerPort', 'COM3')</l>
<l>            set_dict_tuple (RC, 'Data', RD)</l>
<l>            set_dict_tuple (R, '命令', RC)</l>
<l>            WSendWebData (ServerID, R)</l>
<c></c>
<l>        elseif (CMD == 201)</l>
<c>            * 统计数据查询 -> 回复 CMD=201</c>
<l>            create_dict (R)</l>
<l>            create_dict (RC)</l>
<l>            create_dict (RD)</l>
<l>            set_dict_tuple (RC, 'CMD', 201)</l>
<l>            set_dict_tuple (RD, 'total', FrameSeq)</l>
<l>            set_dict_tuple (RD, 'ok', FrameSeq - FrameSeq / 10)</l>
<l>            set_dict_tuple (RD, 'ng', FrameSeq / 10)</l>
<l>            set_dict_tuple (RD, 'avgTime', 35)</l>
<l>            set_dict_tuple (RC, 'Data', RD)</l>
<l>            set_dict_tuple (R, '命令', RC)</l>
<l>            WSendWebData (ServerID, R)</l>
<c></c>
<l>        elseif (CMD == 999)</l>
<l>            disp_message (WindowHandle, '收到退出命令 CMD=999', 'window', 36, 12, 'red', 'true')</l>
<l>            Running := false</l>
<l>            continue</l>
<l>        endif</l>
<l>    catch (Ex)</l>
<c>        * 无命令到达（超时），属于正常流程</c>
<l>    endtry</l>
<c></c>
<c>    * ---- (b) 推一帧图像（CMD=0 → 后端会自动 JPEG 压缩） ----</c>
<l>    read_image (Image, ImgNames[ImgIdx])</l>
<l>    ImgIdx := (ImgIdx + 1) % NumImgs</l>
<l>    get_image_size (Image, W, H)</l>
<l>    count_channels (Image, Ch)</l>
<c></c>
<l>    create_dict (SendDict)</l>
<l>    create_dict (CmdDict)</l>
<l>    create_dict (DataDict)</l>
<l>    set_dict_tuple (CmdDict, 'CMD', 0)</l>
<l>    set_dict_tuple (DataDict, 'id', 0)</l>
<l>    set_dict_tuple (DataDict, 'seq', FrameSeq)</l>
<l>    set_dict_tuple (DataDict, '宽', W)</l>
<l>    set_dict_tuple (DataDict, '高', H)</l>
<l>    set_dict_tuple (DataDict, '位深', 1)</l>
<l>    set_dict_tuple (DataDict, '通道', Ch)</l>
<l>    set_dict_tuple (CmdDict, 'Data', DataDict)</l>
<l>    set_dict_tuple (SendDict, '命令', CmdDict)</l>
<l>    set_dict_object (Image, SendDict, '图')</l>
<l>    WSendWebData (ServerID, SendDict)</l>
<l>    FrameSeq := FrameSeq + 1</l>
<l>    dev_display (Image)</l>
<c></c>
<c>    * ---- (c) 每 1 秒推送设备状态(CMD=3) 和 系统资源(CMD=4) ----</c>
<l>    if (TNow - LastStatusPush >= 1.0)</l>
<l>        LastStatusPush := TNow</l>
<l>        create_dict (S)</l>
<l>        create_dict (SC)</l>
<l>        create_dict (SD)</l>
<l>        set_dict_tuple (SC, 'CMD', 3)</l>
<l>        set_dict_tuple (SD, 'cam', 1)</l>
<l>        set_dict_tuple (SD, 'plc', 1)</l>
<l>        set_dict_tuple (SD, 'db', 1)</l>
<l>        set_dict_tuple (SD, 'feishu', 'ok')</l>
<l>        set_dict_tuple (SD, 'scanner', 1)</l>
<l>        set_dict_tuple (SC, 'Data', SD)</l>
<l>        set_dict_tuple (S, '命令', SC)</l>
<l>        WSendWebData (ServerID, S)</l>
<l>    endif</l>
<c></c>
<l>    if (TNow - LastStatsPush >= 1.0)</l>
<l>        LastStatsPush := TNow</l>
<l>        create_dict (R4)</l>
<l>        create_dict (RC4)</l>
<l>        create_dict (RD4)</l>
<l>        set_dict_tuple (RC4, 'CMD', 4)</l>
<l>        set_dict_tuple (RD4, 'cpu', 25)</l>
<l>        set_dict_tuple (RD4, 'mem', 60)</l>
<l>        set_dict_tuple (RD4, 'resolution', '' + W + 'x' + H)</l>
<l>        set_dict_tuple (RC4, 'Data', RD4)</l>
<l>        set_dict_tuple (R4, '命令', RC4)</l>
<l>        WSendWebData (ServerID, R4)</l>
<l>    endif</l>
<c></c>
<c>    * 控制约 5 fps</c>
<l>    wait_seconds (0.2)</l>
<l>endwhile</l>
<c></c>
<c>* ---------- 4. 关闭 ----------</c>
<l>WCloseWebServer (ServerID)</l>
<l>disp_message (WindowHandle, '服务器已关闭，共推送 ' + FrameSeq + ' 帧', 'window', 60, 12, 'red', 'true')</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
