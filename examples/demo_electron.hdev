<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* ============================================================</c>
<c>* Halcon_UI × Electron 联调演示</c>
<c>*</c>
<c>* 演示三件事：</c>
<c>*   1) 后端持续推送图像到 Electron（CMD=0, JPEG）</c>
<c>*   2) Electron 发送命令 → 后端接收并回复（CMD=100/200）</c>
<c>*   3) Electron 发送 CMD=999 退出循环</c>
<c>*</c>
<c>* 使用方法：</c>
<c>*   1. 先启动 Electron: cd examples/electron &amp;&amp; npm start</c>
<c>*   2. Electron 中点"连接"按钮（默认 ws://127.0.0.1:1802/ws）</c>
<c>*   3. 运行本脚本 — 服务器启动、开始推图</c>
<c>*   4. Electron 中会实时显示图像，可在命令框输入 JSON 发送</c>
<c>* ============================================================</c>
<c></c>
<l>dev_update_off ()</l>
<l>dev_get_window (WindowHandle)</l>
<l>set_display_font (WindowHandle, 14, 'mono', 'true', 'false')</l>
<c></c>
<c>* ---------- 1. 启动 WebSocket 服务器 ----------</c>
<l>Port := 1802</l>
<l>WebRoot := '../web'</l>
<l>WCreateWebServer (Port, WebRoot, ServerID)</l>
<c></c>
<l>disp_message (WindowHandle, '=== Halcon_UI × Electron 演示 ===', 'window', 12, 12, 'lime green', 'false')</l>
<l>disp_message (WindowHandle, 'WebSocket: ws://127.0.0.1:' + Port + '/ws', 'window', 36, 12, 'white', 'false')</l>
<l>disp_message (WindowHandle, 'Electron: cd examples/electron &amp;&amp; npm start', 'window', 60, 12, 'cyan', 'false')</l>
<l>disp_message (WindowHandle, '按 F5 进入主循环', 'window', 84, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c></c>
<c>* ---------- 2. 准备测试图像 ----------</c>
<l>read_image (ImageA, 'fabrik')</l>
<l>read_image (ImageB, 'monkey')</l>
<l>read_image (ImageC, 'mreut')</l>
<l>* Images := [ImageA, ImageB, ImageC]</l>
<l>concat_obj (ImageA, ImageB, Images)</l>
<l>concat_obj (Images, ImageC, Images)</l>
<c></c>
<l>Names := ['fabrik', 'monkey', 'mreut']</l>
<c></c>
<c>* ---------- 3. 主循环 ----------</c>
<l>Running := true</l>
<l>Idx := 0</l>
<l>FrameSeq := 0</l>
<c></c>
<l>while (Running)</l>
<c></c>
<c>    * ---- (a) 非阻塞接收前端命令 ----</c>
<l>    create_dict (RecvDict)</l>
<l>    try</l>
<l>        WRecvWebData (ServerID, 0, RecvDict)</l>
<l>        get_dict_tuple (RecvDict, '命令', CmdJson)</l>
<l>        get_dict_tuple (CmdJson, 'CMD', CMD)</l>
<l>        try</l>
<l>            get_dict_tuple (CmdJson, 'Data', CmdData)</l>
<l>        catch (Ex1)</l>
<l>            create_dict (CmdData)</l>
<l>        endtry</l>
<c></c>
<l>        disp_message (WindowHandle, '&lt;- 收到 CMD=' + CMD, 'window', 120, 12, 'cyan', 'true')</l>
<c></c>
<l>        if (CMD == 999)</l>
<c>            * 前端请求退出</c>
<l>            Running := false</l>
<l>            disp_message (WindowHandle, '前端请求退出', 'window', 144, 12, 'red', 'true')</l>
<l>        elseif (CMD == 100)</l>
<c>            * 通用命令：从 Data 里取 msg 字段回显</c>
<l>            try</l>
<l>                get_dict_tuple (CmdData, 'msg', MsgIn)</l>
<l>            catch (Ex2)</l>
<l>                MsgIn := '(空)'</l>
<l>            endtry</l>
<l>            disp_message (WindowHandle, '   msg = ' + MsgIn, 'window', 144, 12, 'white', 'true')</l>
<c></c>
<c>            * 回复 CMD=200，把 seq 和 echo 带回去</c>
<l>            create_dict (Reply)</l>
<l>            create_dict (ReplyCmd)</l>
<l>            create_dict (ReplyData)</l>
<l>            set_dict_tuple (ReplyCmd, 'CMD', 200)</l>
<l>            set_dict_tuple (ReplyData, 'echo', MsgIn)</l>
<l>            set_dict_tuple (ReplyData, 'seq', FrameSeq)</l>
<l>            set_dict_tuple (ReplyCmd, 'Data', ReplyData)</l>
<l>            set_dict_tuple (Reply, '命令', ReplyCmd)</l>
<l>            WSendWebData (ServerID, Reply)</l>
<l>            disp_message (WindowHandle, '-&gt; 已回复 CMD=200', 'window', 168, 12, 'lime green', 'true')</l>
<l>        endif</l>
<l>    catch (Ex3)</l>
<c>        * 无命令或超时，继续</c>
<l>    endtry</l>
<c></c>
<c>    * ---- (b) 推送一张图像到前端 ----</c>
<l>    count_obj (Images, Number)</l>
<l>    select_obj (Images, ImageNow, Idx % Number)</l>
<l>    *ImageNow := Images[Idx % Number]</l>
<l>    ImageName := Names[Idx % |Names|]</l>
<c></c>
<l>    create_dict (Msg)</l>
<l>    create_dict (Cmd)</l>
<l>    create_dict (Data)</l>
<l>    set_dict_tuple (Cmd, 'CMD', 0)</l>
<l>    set_dict_tuple (Data, '图号', 0)</l>
<l>    set_dict_tuple (Data, 'fmt', 'jpeg')</l>
<l>    set_dict_tuple (Cmd, 'Data', Data)</l>
<l>    set_dict_tuple (Msg, '命令', Cmd)</l>
<l>    set_dict_object (ImageNow, Msg, '图')</l>
<l>    WSendWebData (ServerID, Msg)</l>
<c></c>
<c>    * ---- (c) 在 HDevelop 窗口中也显示 ----</c>
<l>    dev_display (ImageNow)</l>
<l>    disp_message (WindowHandle, '# ' + (Idx + 1) + ' 已推送 ' + ImageName, 'window', 108, 12, 'lime green', 'true')</l>
<c></c>
<l>    Idx := Idx + 1</l>
<l>    FrameSeq := FrameSeq + 1</l>
<c></c>
<c>    * ---- (d) 等一小会儿再推下一帧 ----</c>
<l>    wait_seconds (0.8)</l>
<l>endwhile</l>
<c></c>
<c>* ---------- 4. 清理 ----------</c>
<l>WCloseWebServer (ServerID)</l>
<l>disp_message (WindowHandle, '服务器已关闭', 'window', 200, 12, 'red', 'false')</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
