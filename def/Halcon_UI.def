WCreateWebServer<- CCreateWebServer[::port,web_root:server_id]
short.german
  Create WebSocket server.;

short.english
  Create WebSocket server.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, WebSocket, Server, Network;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  port:               input_control;
  default_type:       integer;
  multivalue:         false;
  sem_type:           number;
  type_list:          integer;

parameter
  web_root:           input_control;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;

parameter
  server_id:          output_control;
  default_type:       handle;
  multivalue:         false;
  sem_type:           handle;
  type_list:          handle;


